{
  "name": "personal-telegram-assist",
  "version": "0.0.1",
  "author": "amwebexpert@gmail.com",
  "repository": "https://github.com/amwebexpert/personal-telegram-assistant",
  "description": "A personal Telegram AI assistant powered by Claude Agent SDK",
  "private": true,
  "scripts": {
    "start": "tsx src/telegram-bot.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "generate:version": "tsx scripts/generate-version.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@lichens-innovation/ts-common": "^1.15.5",
    "dotenv": "^16.5.0",
    "marked": "^18.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/node-telegram-bot-api": "^0.64.8",
    "commitlint": "^21.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md}": "prettier --write"
  }
}
