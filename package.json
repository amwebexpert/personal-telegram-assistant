{
  "name": "personal-telegram-assist",
  "version": "1.6.1",
  "author": "amwebexpert@gmail.com",
  "repository": "https://github.com/amwebexpert/personal-telegram-assistant",
  "description": "A personal Telegram AI assistant powered by Claude Agent SDK",
  "private": true,
  "scripts": {
    "start": "tsx src/telegram-bot.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "generate:version": "tsx scripts/generate-version.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.158",
    "@lichens-innovation/ts-common": "1.16.0",
    "dotenv": "17.4.2",
    "marked": "18.0.4",
    "node-telegram-bot-api": "0.67.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "@types/node-telegram-bot-api": "0.64.14",
    "commitlint": "21.0.2",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md}": "prettier --write"
  }
}
