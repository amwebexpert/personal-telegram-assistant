# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Tavily API key from https://app.tavily.com
TAVILY_API_KEY=

# Path to Google OAuth credentials JSON from Google Cloud Console (Desktop client).
# Recommended: /Users/<you>/.gmail-mcp/gcp-oauth.keys.json — same file for Calendar and Gmail.
GOOGLE_OAUTH_CREDENTIALS_PATH=/Users/your-username/.gmail-mcp/gcp-oauth.keys.json
