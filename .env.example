# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Zapier MCP server URL from https://mcp.zapier.com/ → Connect tab (keep secret)
ZAPIER_MCP_URL=https://mcp.zapier.com/your-server-url

# Display name for this bot instance (used in prompts and /start)
BOT_NAME=My Assistant

# node-telegram-bot-api: honor fileOptions contentType/filename for Buffer sends
NTBA_FIX_350=1
